<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Runs PhantomHaze's own .phext parser and placeholder code on a file, outside Windows.
    PhantomHazeSrc must point at a checkout of PhantomHaze-Security/PhantomHaze.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);CA1416;CS8618</NoWarn>
    <PhantomHazeSrc Condition="'$(PhantomHazeSrc)' == ''">$(MSBuildThisFileDirectory)../../../phantomhaze-security/phantomhaze</PhantomHazeSrc>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="GlobalUsings.cs" />
    <Compile Include="$(PhantomHazeSrc)/PhantomExtensionRuntime.cs" />
    <Compile Include="$(PhantomHazeSrc)/PhantomSvg.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>
</Project>
